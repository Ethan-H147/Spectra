#include <windows.h>

#define IDI_SPECTRA_ICON 101
IDI_SPECTRA_ICON ICON "@SPECTRA_ICON_PATH@"

1 24 "@SPECTRA_MANIFEST_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Fourier Audio Lab\0"
            VALUE "FileDescription", "Spectra Fourier Audio Lab\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "spectra_qt\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Fourier Audio Lab\0"
            VALUE "OriginalFilename", "spectra_qt.exe\0"
            VALUE "ProductName", "Spectra\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
